{
    "name": "xerxes/laravel-rabbitmq-communication",
    "description": "A Laravel package for RabbitMQ messaging with outbox pattern, dead letter queues, and automatic retry mechanisms",
    "keywords": [
        "laravel",
        "rabbitmq",
        "messaging",
        "outbox-pattern",
        "dead-letter-queue",
        "event-driven"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Xerxes"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^9|^10|^11|^12",
        "php-amqplib/php-amqplib": "^3.0",
        "ext-json": "*"
    },
    "require-dev": {
        "nunomaduro/collision": "^7.0|^8.0",
        "nunomaduro/larastan": "^2.0",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Xerxes\\RabbitMQ\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xerxes\\RabbitMQ\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xerxes\\RabbitMQ\\RabbitMQServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
